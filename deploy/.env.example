# 실제 .env 는 커밋하지 않는다 (표준 문서 §12).
#   cp deploy/.env.example deploy/.env

# ── 시뮬레이션 설정 ──────────────────────────────────────────────────────────
# game/config.py 가 GAME_ 접두어로 읽는다. 값이 없으면 코드의 기본값을 쓴다.
GAME_SEED=1
GAME_MAX_TICKS=400
GAME_SPEED_LABEL=instant

# ── 컨테이너 사용자 ──────────────────────────────────────────────────────────
# 바인드 마운트한 소스에 컨테이너가 쓸 수 있도록 호스트 uid 와 맞춘다.
# 값이 다르면: id -u / id -g 로 확인해 고친다.
APP_UID=1000
APP_GID=1000

# ── Phase 3 웹 서비스 ────────────────────────────────────────────────────────
# 아직 쓰이지 않는다. web 서비스를 채울 때 함께 연다.
WEB_PORT=5173

# ── 데이터베이스 (B단계) ──────────────────────────────────────────────────
# 기본값을 두지 않는다. 없으면 compose 가 뜨지 않는다 — 개발용 비밀번호가 배포까지
# 따라가는 사고는 "기본값이 있었다" 에서 시작한다.
POSTGRES_DB=game
POSTGRES_USER=game
POSTGRES_PASSWORD=여기에_직접_생성한_값을_넣는다
