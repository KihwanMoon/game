# 실제 .env 는 커밋하지 않는다 (표준 문서 §12).
#   cp deploy/.env.example deploy/.env

# ── 시뮬레이션 설정 ──────────────────────────────────────────────────────────
# game/config.py 가 GAME_ 접두어로 읽는다. 값이 없으면 코드의 기본값을 쓴다.
GAME_SEED=1
GAME_MAX_TICKS=400
GAME_SPEED_LABEL=instant

# ── 컨테이너 사용자 ──────────────────────────────────────────────────────────
# 바인드 마운트한 소스에 컨테이너가 쓸 수 있도록 호스트 uid 와 맞춘다.
# 값이 다르면: id -u / id -g 로 확인해 고친다.
APP_UID=1000
APP_GID=1000

# ── Phase 3 웹 서비스 ────────────────────────────────────────────────────────
# 아직 쓰이지 않는다. web 서비스를 채울 때 함께 연다.
WEB_PORT=5173

# ── 데이터베이스 (B단계) ──────────────────────────────────────────────────
# 기본값을 두지 않는다. 없으면 compose 가 뜨지 않는다 — 개발용 비밀번호가 배포까지
# 따라가는 사고는 "기본값이 있었다" 에서 시작한다.
POSTGRES_DB=game
POSTGRES_USER=game
POSTGRES_PASSWORD=여기에_직접_생성한_값을_넣는다

# 구글 로그인 (2026-09-16). **없어도 스택은 뜬다** — 그 경로만 503 으로 막히고 아이디·
# 비밀번호 가입은 그대로 돈다. 켜려면 Google Cloud 콘솔에서 OAuth 2.0 클라이언트 id(웹)를
# 만들고, 승인된 JavaScript 원본에 이 서비스의 주소를 넣는다.
#
# **공개값이다** — 구글 버튼이 그대로 싣는다. 비밀이 아니라 환경 구분용이다: 서버가 이
# 값으로 토큰의 `aud` 를 검증하므로 개발용 id 가 배포에 따라가면 로그인이 전부 실패한다.
#
# **클라이언트 시크릿은 필요 없다.** ID 토큰을 검증하는 방식이라 공개 클라이언트로 족하다.
GAME_GOOGLE_CLIENT_ID=
