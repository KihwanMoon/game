# syntax=docker/dockerfile:1

# 프런트엔드 이미지. 파이썬 쪽 `deploy/Dockerfile` 과 파일을 나눈 이유는 두 가지다.
#   - 겹치는 계층이 하나도 없다. 이쪽은 node 로 굽고 nginx 로 서빙하며, 그쪽은 python 을
#     굽는다. 한 파일에 두면 어느 쪽을 고쳐도 상대편 빌드 캐시가 깨진다.
#   - 게이트·pytest 를 도는 ci 계층이 node 를 끌고 다닐 이유가 없다.
# 빌드 컨텍스트는 저장소 루트다(compose 의 context: ..). 프런트가 `../design` 과
# `../game/resources` 를 별칭으로 읽기 때문에 frontend/ 만으로는 빌드되지 않는다.

# Node 22 / npm 11. 호스트 개발 환경과 같은 메이저다 — 계층마다 도구 버전이 갈리면
# 호스트에서 통과한 빌드를 컨테이너가 막는다 (표준 §7.1 과 같은 이유).
ARG NODE_VERSION=22


# ─────────────────────────────────────────────────────────────────────────────
# 빌드 계층. `npm run build` 가 `tsc --noEmit && vite build` 라, 타입 오류는 여기서
# 이미지가 만들어지기 전에 걸린다.
FROM node:${NODE_VERSION}-alpine AS build

WORKDIR /build/frontend

# 잠금 파일만 먼저 넣는다. 소스 수정이 설치 계층의 캐시를 깨지 않게 하려는 것이다.
# `npm ci` 는 package-lock.json 과 어긋나면 실패한다 — 컨테이너가 조용히 다른 버전을
# 쓰는 것보다 낫다 (파이썬 쪽 `uv sync --frozen` 과 같은 규약).
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# 디자인 토큰과 밸런스 JSON 은 **복사본이 아니라 저장소의 원본**이다. vite 별칭
# `@design`·`@resources` 가 저장소 상위를 가리키므로 컨텍스트 안에서도 같은 상대 위치에
# 둔다. 여기서 경로를 바꾸면 호스트 빌드와 컨테이너 빌드가 다른 파일을 읽게 된다.
COPY design/ /build/design/
COPY game/resources/ /build/game/resources/

COPY frontend/ ./
RUN npm run build


# ─────────────────────────────────────────────────────────────────────────────
# 서빙 계층. 산출물은 정적 파일뿐이라 런타임에 node 가 필요 없다.
FROM nginx:alpine AS serve

# 8090 을 듣는다. Cloudflare Tunnel 이 host:8090 으로 직접 들어오고, edge-proxy 도
# game-frontend-1:8090 으로 프록시한다. 두 계약이 같은 포트를 본다.
COPY deploy/nginx/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/frontend/dist /usr/share/nginx/html

EXPOSE 8090
