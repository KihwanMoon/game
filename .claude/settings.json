{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/*.py)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_python_file.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "파이썬 표준 검사 중..."
          },
          {
            "type": "command",
            "if": "Write(**/*.py)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_python_file.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "파이썬 표준 검사 중..."
          }
        ]
      }
    ]
  }
}
