{
  "_comment": [
    "밸런스 초안 (로드맵 Phase 0). 밸런스 수치는 코드에 하드코딩하지 않는다 (TDD §2) —",
    "데이터 수정만으로 재빌드 없이 튜닝하기 위해서다.",
    "",
    "모든 계수는 정수 퍼센트다. TDD §8 의 수식은 skill_coef 와 방어 감쇠를 실수로 적었지만",
    "TDD §12 R5 는 '정수 연산 원칙'을 요구한다. 둘이 충돌하므로 정수 쪽을 택했다 —",
    "부동소수는 플랫폼마다 결과가 갈릴 수 있고 그러면 리플레이·골든 테스트가 무너진다.",
    "정수로 옮긴 수식은 damage_formula 에 적어 두었다."
  ],
  "balance_version": 1,

  "damage_formula": {
    "_note": "TDD §8 을 정수 연산으로 옮긴 것. // 는 내림 나눗셈이다.",
    "defense_denominator": "defense + soft_cap_base + soft_cap_per_floor * floor",
    "raw": "(attack * skill_coef_pct * (denominator - defense)) // (100 * denominator)",
    "surrounded_pct": "min(surround_cap_pct, 100 + surround_step_pct * (adjacent_enemies - 1))",
    "final": "max(min_damage, raw * surrounded_pct // 100)",
    "soft_cap_base": 50,
    "soft_cap_per_floor": 10,
    "surround_step_pct": 10,
    "surround_cap_pct": 140,
    "min_damage": 1
  },

